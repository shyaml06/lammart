+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import { app } from '../src/app';
+import { closeDb, getDb } from '../src/db/client';
+import { runMigrations } from '../src/db/migrate';
+import { hashPassword } from '../src/modules/auth/passwords';
+
+const password = 'Local testing only! 926';
+const adminEmail = 'operator@example.test';
+const customerInput = { name: 'Local customer', email: 'customer@example.test', phone: '9876543210', password };
+const login = (emailOrPhone: string) => ({ emailOrPhone, password });
+let admin: ReturnType<typeof request.agent>;
+let customer: ReturnType<typeof request.agent>;
+let dealer: ReturnType<typeof request.agent>;
+
+describe('Authentication and administration', () => {
+  beforeEach(async () => {
+    admin = request.agent(app);
+    customer = request.agent(app);
+    dealer = request.agent(app);
+    process.env.DB_PATH = ':memory:';
+    const db = getDb({ forceNew: true });
+    runMigrations(db);
+    const insert = db.prepare('INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, ?)');
+    const hashed = await hashPassword(password);
+    insert.run('Operator', adminEmail, hashed, 'admin');
+    insert.run('Dealer', 'dealer@example.test', hashed, 'dealer');
+  });
+
+  afterEach(() => {
+    closeDb();
+    delete process.env.DB_PATH;
+  });
+
+  it('keeps admin routes private and registration assigns the customer role', async () => {
+    expect((await request(app).get('/api/v1/admin/dashboard')).status).toBe(401);
+    const result = await customer.post('/api/v1/auth/register').send({ ...customerInput, role: 'admin', isActive: false });
+    expect(result.status).toBe(201);
+    expect(result.body.user).toMatchObject({ role: 'customer', isActive: true });
+    expect(result.body.user).not.toHaveProperty('password_hash');
+    expect(result.get('Set-Cookie')?.[0]).toMatch(/HttpOnly; SameSite=Strict/);
+    expect((await customer.get('/api/v1/me')).body.user.email).toBe(customerInput.email);
+    expect((await customer.get('/api/v1/admin/dashboard')).status).toBe(403);
+    expect((await customer.post('/api/v1/admin/categories').send({ name: 'Restricted category' })).status).toBe(403);
+    expect((await dealer.post('/api/v1/auth/login').send(login('dealer@example.test'))).status).toBe(200);
+    expect((await dealer.get('/api/v1/admin/enquiries')).status).toBe(403);
+  });
+
+  it('authenticates admins and revokes sessions on logout', async () => {
+    const bad = await request(app).post('/api/v1/auth/login').send({ ...login(adminEmail), password: 'incorrect' });
+    expect(bad.status).toBe(401);
+    const session = request.agent(app);
+    const ok = await session.post('/api/v1/auth/login').send(login(adminEmail.toUpperCase()));
+    expect(ok.status).toBe(200);
+    const cookie = ok.get('Set-Cookie')![0].split(';')[0];
+    expect((await session.get('/api/v1/admin/dashboard')).status).toBe(200);
+    expect((await session.post('/api/v1/auth/logout')).status).toBe(200);
+    expect((await session.get('/api/v1/me')).status).toBe(401);
+    expect((await request(app).get('/api/v1/me').set('Cookie', cookie)).status).toBe(401);
+  });
+
+  it('lets an admin publish catalog data, edit variant stock and remove an archived product from search', async () => {
+    expect((await admin.post('/api/v1/auth/login').send(login(adminEmail))).status).toBe(200);
+    const category = await admin.post('/api/v1/admin/categories').send({ name: 'Laminates' });
+    const brand = await admin.post('/api/v1/admin/brands').send({ name: 'Local Brand' });
+    expect(category.status).toBe(201);
+    expect(brand.status).toBe(201);
+    const product = await admin.post('/api/v1/admin/products').send({
+      categoryId: category.body.id, brandId: brand.body.id, name: 'Walnut Sheet', unit: 'sheet', gstRate: 12,
+    });
+    expect(product.status).toBe(201);
+    const variant = await admin.post(`/api/v1/admin/products/${product.body.id}/variants`).send({
+      sku: 'WALNUT-1', price: 123400, stock: 20, moq: 2, attributes: { thickness: '1 mm', finish: 'matte' },
+    });
+    expect(variant.status).toBe(201);
+    const result = await request(app).get('/api/v1/products').query({ q: 'Walnut', thickness: '1 mm' });
+    expect(result.body.data).toHaveLength(1);
+    const facets = await request(app).get('/api/v1/filters').query({ category: 'laminates' });
+    expect(facets.body.thickness).toContainEqual({ value: '1 mm', count: 1 });
+    expect(facets.body.brand).toContainEqual({ value: 'Local Brand', slug: 'local-brand', count: 1 });
+    const changed = await admin.patch(`/api/v1/admin/variants/${variant.body.id}`).send({ price: 190000 });
+    expect(changed.body).toMatchObject({ price: 190000, stock: 20, moq: 2 });
+    expect((await admin.put(`/api/v1/admin/products/${product.body.id}`).send({ name: 'Walnut Panel' })).status).toBe(200);
+    const detail = await admin.get(`/api/v1/admin/products/${product.body.id}`);
+    expect(detail.body).toMatchObject({ name: 'Walnut Panel', gstRate: 12, unit: 'sheet' });
+    expect((await admin.delete(`/api/v1/admin/products/${product.body.id}`)).status).toBe(204);
+    expect((await request(app).get('/api/v1/products/walnut-sheet')).status).toBe(404);
+    expect((await request(app).get('/api/v1/products').query({ q: 'Walnut' })).body.data).toHaveLength(0);
+  });
+
+  it('exposes enquiries only to admins and applies role changes to subsequent sessions', async () => {
+    expect((await admin.post('/api/v1/auth/login').send(login(adminEmail))).status).toBe(200);
+    const enquiry = await request(app).post('/api/v1/contact').send({
+      name: 'Local enquiry', phone: customerInput.phone, subject: 'Samples', message: 'Walnut sample request.',
+    });
+    expect(enquiry.status).toBe(201);
+    const inbox = await admin.get('/api/v1/admin/enquiries');
+    expect(inbox.body.data[0].reference).toBe(enquiry.body.reference);
+    const { user } = (await customer.post('/api/v1/auth/register').send(customerInput)).body;
+    const own = (await admin.get('/api/v1/me')).body.user;
+    expect((await admin.patch(`/api/v1/admin/users/${own.id}`).send({ role: 'customer', isActive: false })).status).toBe(409);
+    expect((await admin.patch(`/api/v1/admin/users/${user.id}`).send({ role: 'admin', isActive: true })).status).toBe(200);
+    expect((await customer.get('/api/v1/admin/dashboard')).status).toBe(401);
+    expect((await customer.post('/api/v1/auth/login').send(login(customerInput.email))).status).toBe(200);
+    expect((await customer.get('/api/v1/admin/dashboard')).status).toBe(200);
+    expect((await admin.patch(`/api/v1/admin/users/${user.id}`).send({ role: 'dealer', isActive: false })).status).toBe(200);
+    expect((await customer.get('/api/v1/me')).status).toBe(401);
+    expect((await customer.post('/api/v1/auth/login').send(login(customerInput.email))).status).toBe(401);
+  });
+});
