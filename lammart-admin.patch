+import { z } from 'zod';
+import { config } from '../../config';
+import { getDb, closeDb, inTransaction } from '../../db/client';
+import { runMigrations } from '../../db/migrate';
+import { hashPassword } from './passwords';
+
+const credentials = z.object({
+  name: z.string().trim().min(2).max(100),
+  email: z.string().trim().email().max(254).toLowerCase(),
+  password: z.string().min(12).max(128),
+});
+
+async function main() {
+  if (config.isProduction && !process.env.DB_PATH) throw new Error('Set DB_PATH to the API database.');
+  const input = credentials.safeParse({
+    name: process.env.ADMIN_NAME || 'Administrator',
+    email: process.env.ADMIN_EMAIL,
+    password: process.env.ADMIN_PASSWORD,
+  });
+  if (!input.success) throw new Error('Set ADMIN_EMAIL and ADMIN_PASSWORD (12–128 characters).');
+  const { name, email, password } = input.data;
+  const hash = await hashPassword(password);
+  const db = getDb();
+  runMigrations(db);
+  inTransaction(db, () => {
+    const existing = db.prepare('SELECT id, role FROM users WHERE email = ? COLLATE NOCASE LIMIT 2').all(email);
+    if (existing.length) {
+      if (existing.length !== 1 || existing[0].role !== 'admin' || !process.argv.includes('--reset-password')) {
+        throw new Error('That email already exists. Use --reset-password only for an existing administrator.');
+      }
+      const id = Number(existing[0].id);
+      db.prepare('UPDATE users SET password_hash = ?, is_active = 1 WHERE id = ?').run(hash, id);
+      db.prepare('DELETE FROM auth_sessions WHERE user_id = ?').run(id);
+    } else {
+      db.prepare("INSERT INTO users (name, email, password_hash, role) VALUES (?, ?, ?, 'admin')")
+        .run(name, email, hash);
+    }
+  });
+  console.log('Administrator credentials saved.');
+}
+
+main().catch((error: unknown) => {
+  console.error(error instanceof Error ? error.message : 'Could not save administrator credentials.');
+  process.exitCode = 1;
+}).finally(closeDb);
