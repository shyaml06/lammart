+        <div className="space-y-3">
+          <button className={outline} onClick={() => setSelected(null)}>Back to product list</button>
+          <ProductDetail key={selected} id={selected} categories={categories.data} brands={brands.data} refreshCatalog={refresh} />
+        </div>
+      ) : <section className={panel}>
+        <h2 className="mb-3 font-bold">New product</h2>
+        {categories.data.some(row => row.isActive) ? <ProductEditor categories={categories.data} brands={brands.data} save={async payload => {
+          const { id } = await accountRequest<{ id: number }>('/admin/products', { method: 'POST', body: JSON.stringify(payload) });
+          setSelected(id);
+          setPage(1);
+          refresh();
+        }} /> : <p className="text-sm text-slate-600">Add a category before creating a product.</p>}
+      </section>
+    )}
+    {selected === null && <section className={panel}>
+      <h2 className="mb-3 font-bold">Products</h2>
+      {products.data ? <div className="space-y-3">
+        {products.data.data.length ? <ul className="divide-y divide-[#E7E2D9]">{products.data.data.map(product => (
+          <li className="flex flex-wrap items-center justify-between gap-2 py-3" key={product.id}>
+            <div><p className="font-semibold">{product.name}</p><p className="text-sm text-slate-600">{product.isActive ? 'Listed' : 'Hidden'}</p></div>
+            <button className={outline} onClick={() => setSelected(product.id)}>Edit {product.name}</button>
+          </li>
