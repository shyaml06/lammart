+}
+
+function Enquiries() {
+  const [page, setPage] = useState(1);
+  const { data, error } = useAdminResource<ListPage<Enquiry>>(`/enquiries?page=${page}`);
+  if (!data) return <ResourceState error={error} />;
+  return <div className="space-y-3">
+    {data.data.length === 0 && <p className={panel}>No enquiries received.</p>}
