diff --git a/apps/api/src/modules/admin/admin.router.ts b/apps/api/src/modules/admin/admin.router.ts
new file mode 100644
index 0000000..3907ef6
--- /dev/null
+++ b/apps/api/src/modules/admin/admin.router.ts
@@ -0,0 +1,287 @@
+import { randomUUID } from 'node:crypto';
+import { Router, type Request, type Response, type RequestHandler } from 'express';
+import { z } from 'zod';
+import { createBrandSchema, createCategorySchema, createProductSchema, createVariantSchema } from '@lammart/shared';
+import { getDb, inTransaction } from '../../db/client';
+import { syncProductSearch } from '../../db/search';
+import { accountFields, requireRole, requireSession, sameOriginWrite, type Account } from '../auth/session';
+
+export const adminRouter = Router();
+adminRouter.use((_req, res, next) => { res.set('Cache-Control', 'no-store'); next(); });
+adminRouter.use(requireSession, requireRole('admin'), sameOriginWrite);
+
+class AdminError extends Error {
+  constructor(readonly status: number, message: string) { super(message); }
+}
+
+function handle(fn: (req: Request, res: Response) => void): RequestHandler {
+  return (req, res, next) => {
+    try { fn(req, res); }
+    catch (error) {
+      const errno = typeof error === 'object' && error !== null && 'errcode' in error ? error.errcode : undefined;
+      if (error instanceof AdminError) res.status(error.status).json({ error: error.message });
+      else if (error instanceof z.ZodError) res.status(400).json({ error: error.issues[0]?.message ?? 'Invalid input.' });
+      else if (errno === 2067 || errno === 1555) res.status(409).json({ error: 'That name, slug, or SKU is already in use.' });
+      else if (errno === 787) res.status(400).json({ error: 'The selected category, brand, or product does not exist.' });
+      else next(error);
+    }
+  };
+}
+
+const idSchema = z.coerce.number().int().positive();
+const pageSchema = idSchema.max(100_000).default(1);
+const pageSize = 25;
+const slugSchema = z.string().trim().max(150).regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/, 'Use lowercase letters, numbers and hyphens for the slug.');
+const activeSchema = z.boolean();
+const shortText = (max: number) => z.string().trim().max(max);
+const imagePath = z.string().trim().max(1000).refine(
+  value => /^https:\/\//i.test(value) || /^\/(?![\/\\])/.test(value),
+  'Image must be an HTTPS URL or a local /path.'
+);
+function toSlug(name: string): string {
+  return name.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 140).replace(/^-+|-+$/g, '') || randomUUID();
+}
+
+const categoryInput = createCategorySchema.extend({
+  name: shortText(150).min(1),
+  slug: slugSchema.optional(),
+  description: shortText(4000).optional(),
+  image: imagePath.optional(),
+});
+const brandInput = createBrandSchema.extend({
+  name: shortText(100).min(1), slug: slugSchema.optional(), logo: imagePath.optional(),
+});
+const productInput = createProductSchema.extend({
+  name: shortText(300).min(1),
+  brandId: idSchema.nullable().optional(),
+  description: shortText(4000).optional(),
+  hsnCode: shortText(32).optional(),
+  slug: slugSchema.optional(),
+  isActive: activeSchema.default(true),
+  imageUrl: imagePath.nullable().optional(),
+});
+const productUpdate = productInput.extend({
+  gstRate: productInput.shape.gstRate.removeDefault(),
+  unit: productInput.shape.unit.removeDefault(),
+  isHeavy: productInput.shape.isHeavy.removeDefault(),
+  isActive: activeSchema,
+}).partial();
+const attributesInput = z.record(shortText(40).min(1), shortText(100).min(1))
+  .refine(attributes => Object.keys(attributes).length <= 30, 'Use at most 30 variant attributes.');
+const variantInput = createVariantSchema.omit({ productId: true }).extend({
+  sku: shortText(50).min(1),
+  designCode: shortText(80).nullable().optional(),
+  optionLabel: shortText(150).nullable().optional(),
+  mrp: z.number().int().positive().nullable().optional(),
+  weightGrams: z.number().int().positive().nullable().optional(),
+  attributes: attributesInput.optional(),
+  isActive: activeSchema.default(true),
+});
+
+const variantUpdate = variantInput.extend({
+  stock: variantInput.shape.stock.removeDefault(),
+  moq: variantInput.shape.moq.removeDefault(),
+  isActive: activeSchema,
+}).partial();
+
+const productFields = `p.id, p.name, p.slug, p.description, p.category_id AS categoryId, p.brand_id AS brandId,
+  p.hsn_code AS hsnCode, p.gst_rate AS gstRate, p.unit, p.is_heavy AS isHeavy, p.is_active AS isActive,
+  (SELECT path FROM product_images WHERE product_id = p.id AND variant_id IS NULL ORDER BY sort_order, id LIMIT 1) AS imageUrl`;
+const variantFields = `id, product_id AS productId, sku, design_code AS designCode, option_label AS optionLabel,
+  price, mrp, stock, weight_grams AS weightGrams, moq, is_active AS isActive`;
+
+adminRouter.get('/dashboard', handle((_req, res) => {
+  res.json(getDb().prepare(`SELECT
+    (SELECT COUNT(*) FROM products WHERE is_active = 1) AS activeProducts,
+    (SELECT COUNT(*) FROM categories WHERE is_active = 1) AS categories,
+    (SELECT COUNT(*) FROM contact_enquiries) AS enquiries,
+    (SELECT COUNT(*) FROM users WHERE is_active = 1) AS activeUsers`).get());
+}));
+
+adminRouter.get('/categories', handle((_req, res) => {
+  res.json(getDb().prepare('SELECT id, name, slug, parent_id AS parentId, is_active AS isActive FROM categories ORDER BY name, id').all());
+}));
+adminRouter.post('/categories', handle((req, res) => {
+  const input = categoryInput.parse(req.body);
+  const row = getDb().prepare(`
+    INSERT INTO categories (name, slug, parent_id, description, image, sort_order, is_active)
+    VALUES (?, ?, ?, ?, ?, ?, ?) RETURNING id, name, slug
+  `).get(input.name, input.slug ?? toSlug(input.name), input.parentId ?? null, input.description ?? null, input.image ?? null, input.sortOrder, Number(input.isActive));
+  res.status(201).json(row);
+}));
+
+adminRouter.get('/brands', handle((_req, res) => {
+  res.json(getDb().prepare('SELECT id, name, slug FROM brands ORDER BY name, id').all());
+}));
+adminRouter.post('/brands', handle((req, res) => {
+  const input = brandInput.parse(req.body);
+  res.status(201).json(getDb().prepare('INSERT INTO brands (name, slug, logo) VALUES (?, ?, ?) RETURNING id, name, slug')
+    .get(input.name, input.slug ?? toSlug(input.name), input.logo ?? null));
+}));
+
+adminRouter.get('/products', handle((req, res) => {
+  const page = pageSchema.parse(req.query.page);
+  const db = getDb();
+  const data = db.prepare(`SELECT ${productFields} FROM products p ORDER BY p.id DESC LIMIT ? OFFSET ?`)
+    .all(pageSize, (page - 1) * pageSize);
+  res.json({ data, page, total: db.prepare('SELECT COUNT(*) AS total FROM products').get()?.total, limit: pageSize });
+}));
+
+adminRouter.get('/products/:id', handle((req, res) => {
+  const id = idSchema.parse(req.params.id);
+  const db = getDb();
+  const product = db.prepare(`SELECT ${productFields} FROM products p WHERE p.id = ?`).get(id);
+  if (!product) throw new AdminError(404, 'Product not found.');
+  const attributes = db.prepare('SELECT key, value FROM variant_attributes WHERE variant_id = ? ORDER BY key');
+  const variants = db.prepare(`SELECT ${variantFields} FROM product_variants WHERE product_id = ? ORDER BY id`).all(id)
+    .map(variant => ({ ...variant, attributes: Object.fromEntries(attributes.all(Number(variant.id)).map(row => [row.key, row.value])) }));
+  res.json({ ...product, variants });
+}));
+
+function saveImage(productId: number, imageUrl?: string | null) {
+  if (imageUrl === undefined) return;
+  const db = getDb();
+  const first = db.prepare(`SELECT id FROM product_images WHERE product_id = ? AND variant_id IS NULL ORDER BY sort_order, id LIMIT 1`).get(productId);
+  if (first) {
+    if (imageUrl) db.prepare('UPDATE product_images SET path = ? WHERE id = ?').run(imageUrl, Number(first.id));
+    else db.prepare('DELETE FROM product_images WHERE id = ?').run(Number(first.id));
+  } else if (imageUrl) {
+    db.prepare('INSERT INTO product_images (product_id, path) VALUES (?, ?)').run(productId, imageUrl);
+  }
+}
+
+adminRouter.post('/products', handle((req, res) => {
+  const input = productInput.parse(req.body);
+  const db = getDb();
+  const id = inTransaction(db, () => {
+    const created = Number(db.prepare(`
+      INSERT INTO products (name, slug, category_id, brand_id, description, hsn_code, gst_rate, unit, is_heavy, is_active)
+      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+    `).run(input.name, input.slug ?? toSlug(input.name), input.categoryId, input.brandId ?? null, input.description ?? null,
+      input.hsnCode ?? null, input.gstRate, input.unit, Number(input.isHeavy), Number(input.isActive)).lastInsertRowid);
+    saveImage(created, input.imageUrl);
+    syncProductSearch(db, created);
+    return created;
+  });
+  res.status(201).json({ id });
+}));
+
+adminRouter.put('/products/:id', handle((req, res) => {
+  const id = idSchema.parse(req.params.id);
+  const input = productUpdate.parse(req.body);
+  const db = getDb();
+  inTransaction(db, () => {
+    const current = db.prepare(`SELECT ${productFields} FROM products p WHERE p.id = ?`).get(id);
+    if (!current) throw new AdminError(404, 'Product not found.');
+    db.prepare(`
+      UPDATE products SET name = ?, slug = ?, category_id = ?, brand_id = ?, description = ?, hsn_code = ?,
+        gst_rate = ?, unit = ?, is_heavy = ?, is_active = ?, updated_at = datetime('now') WHERE id = ?
+    `).run(input.name ?? current.name, input.slug ?? current.slug, input.categoryId ?? current.categoryId,
+      input.brandId === undefined ? current.brandId : input.brandId, input.description ?? current.description,
+      input.hsnCode ?? current.hsnCode, input.gstRate ?? current.gstRate, input.unit ?? current.unit,
+      Number(input.isHeavy ?? current.isHeavy), Number(input.isActive ?? current.isActive), id);
+    saveImage(id, input.imageUrl);
+    syncProductSearch(db, id);
+  });
+  res.json({ id });
+}));
+
+adminRouter.delete('/products/:id', handle((req, res) => {
+  const id = idSchema.parse(req.params.id);
+  const db = getDb();
+  inTransaction(db, () => {
+    const { changes } = db.prepare("UPDATE products SET is_active = 0, updated_at = datetime('now') WHERE id = ?").run(id);
+    if (!changes) throw new AdminError(404, 'Product not found.');
+    syncProductSearch(db, id);
+  });
+  res.sendStatus(204);
+}));
+
+function saveAttributes(variantId: number, attributes: Record<string, string>) {
+  const db = getDb();
+  db.prepare('DELETE FROM variant_attributes WHERE variant_id = ?').run(variantId);
+  const insert = db.prepare('INSERT INTO variant_attributes (variant_id, key, value) VALUES (?, ?, ?)');
+  for (const [key, value] of Object.entries(attributes)) insert.run(variantId, key, value);
+}
+
+adminRouter.post('/products/:id/variants', handle((req, res) => {
+  const productId = idSchema.parse(req.params.id);
+  const input = variantInput.parse(req.body);
+  const db = getDb();
+  const id = inTransaction(db, () => {
+    const created = Number(db.prepare(`
+      INSERT INTO product_variants (product_id, sku, design_code, option_label, price, mrp, stock, weight_grams, moq, is_active)
+      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+    `).run(productId, input.sku, input.designCode ?? null, input.optionLabel ?? null, input.price, input.mrp ?? null,
+      input.stock, input.weightGrams ?? null, input.moq, Number(input.isActive)).lastInsertRowid);
+    saveAttributes(created, input.attributes ?? {});
+    syncProductSearch(db, productId);
+    return created;
+  });
+  res.status(201).json({ id });
+}));
+
+adminRouter.patch('/variants/:id', handle((req, res) => {
+  const id = idSchema.parse(req.params.id);
+  const input = variantUpdate.parse(req.body);
+  const db = getDb();
+  const variant = inTransaction(db, () => {
+    const current = db.prepare(`SELECT ${variantFields} FROM product_variants WHERE id = ?`).get(id);
+    if (!current) throw new AdminError(404, 'Variant not found.');
+    const updated = db.prepare(`
+      UPDATE product_variants SET sku = ?, design_code = ?, option_label = ?, price = ?, mrp = ?,
+        stock = ?, weight_grams = ?, moq = ?, is_active = ? WHERE id = ? RETURNING ${variantFields}
+    `).get(input.sku ?? current.sku, input.designCode === undefined ? current.designCode : input.designCode,
+      input.optionLabel === undefined ? current.optionLabel : input.optionLabel, input.price ?? current.price,
+      input.mrp === undefined ? current.mrp : input.mrp, input.stock ?? current.stock,
+      input.weightGrams === undefined ? current.weightGrams : input.weightGrams, input.moq ?? current.moq,
+      Number(input.isActive ?? current.isActive), id);
+    if (input.attributes) saveAttributes(id, input.attributes);
+    syncProductSearch(db, Number(current.productId));
+    return updated;
+  });
+  res.json(variant);
+}));
+
+adminRouter.get('/enquiries', handle((req, res) => {
+  const page = pageSchema.parse(req.query.page);
+  const db = getDb();
+  const data = db.prepare(`SELECT reference, name, phone, email, subject, message, items_json AS itemsJson, created_at AS createdAt
+    FROM contact_enquiries ORDER BY created_at DESC, reference DESC LIMIT ? OFFSET ?`).all(pageSize, (page - 1) * pageSize);
+  res.json({ data, page, total: db.prepare('SELECT COUNT(*) AS total FROM contact_enquiries').get()?.total, limit: pageSize });
+}));
+
+adminRouter.get('/users', handle((req, res) => {
+  const page = pageSchema.parse(req.query.page);
+  const db = getDb();
+  const data = db.prepare(`SELECT ${accountFields} FROM users ORDER BY id DESC LIMIT ? OFFSET ?`)
+    .all(pageSize, (page - 1) * pageSize).map(row => ({ ...row, isActive: Boolean(row.isActive) }));
+  res.json({ data, page, total: db.prepare('SELECT COUNT(*) AS total FROM users').get()?.total, limit: pageSize });
+}));
+
+adminRouter.patch('/users/:id', handle((req, res) => {
+  const id = idSchema.parse(req.params.id);
+  const input = z.object({ role: z.enum(['customer', 'dealer', 'admin']), isActive: activeSchema }).parse(req.body);
+  if (id === (res.locals.user as Account).id) throw new AdminError(409, 'You cannot change your own role or account status.');
+  const db = getDb();
+  inTransaction(db, () => {
+    const { changes } = db.prepare('UPDATE users SET role = ?, is_active = ? WHERE id = ?')
+      .run(input.role, Number(input.isActive), id);
+    if (!changes) throw new AdminError(404, 'User not found.');
+    db.prepare('DELETE FROM auth_sessions WHERE user_id = ?').run(id);
+  });
+  res.json({ id, ...input });
+}));
+
+adminRouter.get('/settings', handle((_req, res) => {
+  res.json(Object.fromEntries(getDb().prepare('SELECT key, value FROM settings').all().map(row => [row.key, row.value])));
+}));
+adminRouter.put('/settings', handle((req, res) => {
+  const input = z.record(z.string().regex(/^[A-Za-z][A-Za-z0-9_-]{0,79}$/), shortText(2000)).parse(req.body);
+  const db = getDb();
+  inTransaction(db, () => {
+    const put = db.prepare('INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value');
+    for (const [key, value] of Object.entries(input)) if (value !== undefined) put.run(key, value);
+  });
+  res.json(input);
+}));
diff --git a/apps/api/src/modules/auth/auth.router.ts b/apps/api/src/modules/auth/auth.router.ts
new file mode 100644
index 0000000..013e352
--- /dev/null
+++ b/apps/api/src/modules/auth/auth.router.ts
@@ -0,0 +1,96 @@
+import { Router } from 'express';
+import { rateLimit } from 'express-rate-limit';
+import { loginSchema, registerSchema } from '@lammart/shared';
+import { getDb } from '../../db/client';
+import { hashPassword, verifyPassword } from './passwords';
+import { accountFields, requireSession, sameOriginWrite, startSession, endSession, type Account } from './session';
+
+export const authRouter = Router();
+authRouter.use(['/auth', '/me'], (_req, res, next) => {
+  res.set('Cache-Control', 'no-store');
+  next();
+});
+
+const attempts = rateLimit({
+  windowMs: 15 * 60_000,
+  limit: 30,
+  skipSuccessfulRequests: true,
+  standardHeaders: 'draft-7',
+  legacyHeaders: false,
+  validate: { xForwardedForHeader: false },
+  message: { error: 'Too many attempts. Try again later.' },
+});
+const registrationLimit = rateLimit({
+  windowMs: 15 * 60_000, limit: 30, standardHeaders: 'draft-7', legacyHeaders: false,
+  validate: { xForwardedForHeader: false }, message: { error: 'Too many requests. Try again later.' },
+});
+
+authRouter.post('/auth/register', sameOriginWrite, registrationLimit, async (req, res, next) => {
+  const parsed = registerSchema.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ error: 'Enter a name, valid Indian mobile number, and a password of 8–128 characters.' });
+    return;
+  }
+  const { name, email, phone, password } = parsed.data;
+  const normalizedEmail = email?.toLowerCase() ?? null;
+  try {
+    const hash = await hashPassword(password);
+    const db = getDb();
+    const row = db.prepare(`
+      INSERT INTO users (name, email, phone, password_hash, role)
+      SELECT ?, ?, ?, ?, 'customer'
+      WHERE NOT EXISTS (SELECT 1 FROM users WHERE email = ? COLLATE NOCASE OR phone = ?)
+      ON CONFLICT DO NOTHING
+      RETURNING ${accountFields}
+    `).get(name.trim(), normalizedEmail, phone, hash, normalizedEmail, phone);
+    if (!row) {
+      res.status(409).json({ error: 'An account with these details already exists.' });
+      return;
+    }
+    startSession(req, res, Number(row.id));
+    res.status(201).json({ user: { ...row, isActive: true } });
+  } catch (error) { next(error); }
+});
+
+authRouter.post('/auth/login', sameOriginWrite, attempts, async (req, res, next) => {
+  const parsed = loginSchema.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ error: 'Enter your email or phone and password.' });
+    return;
+  }
+  const { emailOrPhone, password } = parsed.data;
+  try {
+    const db = getDb();
+    const accounts = db.prepare(`
+      SELECT ${accountFields}, password_hash FROM users
+      WHERE (email = ? COLLATE NOCASE OR phone = ?) AND is_active = 1 LIMIT 2
+    `).all(emailOrPhone, emailOrPhone) as unknown as (Account & { password_hash: string })[];
+    const account = accounts.length === 1 ? accounts[0] : undefined;
+    const valid = await verifyPassword(password, account?.password_hash);
+    // Older demo databases must not grant admin access with the published fixture password.
+    if (!account || !valid || (account.role === 'admin' && password === 'Admin@12345')) {
+      res.status(401).json({ error: 'Invalid credentials.' });
+      return;
+    }
+    const { password_hash: storedHash, ...user } = account;
+    const upgrade = storedHash.startsWith('$2') ? await hashPassword(password) : null;
+    if (upgrade) {
+      db.prepare('UPDATE users SET password_hash = ? WHERE id = ? AND password_hash = ? AND is_active = 1')
+        .run(upgrade, user.id, storedHash);
+    }
+    const current = db.prepare(`SELECT ${accountFields} FROM users WHERE id = ? AND password_hash = ? AND is_active = 1`)
+      .get(user.id, upgrade ?? storedHash);
+    if (!current || (current.role === 'admin' && password === 'Admin@12345')) {
+      res.status(401).json({ error: 'Invalid credentials.' });
+      return;
+    }
+    startSession(req, res, user.id);
+    res.json({ user: { ...current, isActive: true } });
+  } catch (error) { next(error); }
+});
+
+authRouter.get('/me', requireSession, (_req, res) => res.json({ user: res.locals.user }));
+authRouter.post('/auth/logout', sameOriginWrite, (req, res) => {
+  endSession(req, res);
+  res.json({ success: true });
+});
