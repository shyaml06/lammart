+'use client';
+
+import { useEffect, useState, type FormEvent, type ReactNode } from 'react';
+import { AccountRequestError, accountRequest, type Account } from '@/lib/account-api';
+import { SignOutButton } from '@/components/account/account-form';
+
+const tabs = ['Overview', 'Catalog', 'Enquiries', 'Users'] as const;
+const button = 'rounded-lg bg-[#0B7A55] px-4 py-2 text-sm font-semibold text-white disabled:opacity-60';
+const outline = 'rounded-lg border border-[#D9D3C7] px-3 py-2 text-sm font-semibold disabled:opacity-50';
+const control = 'mt-1 w-full rounded-lg border border-[#D9D3C7] bg-white px-3 py-2 text-sm';
+const panel = 'rounded-2xl border border-[#E7E2D9] bg-white p-4 sm:p-6';
+const grid = 'grid gap-3 sm:grid-cols-2';
+const roles = ['customer', 'dealer', 'admin'] as const;
+
+type ListPage<T> = { data: T[]; page: number; total: number; limit: number };
+type Taxonomy = { id: number; name: string; slug: string; parentId?: number | null; isActive?: number };
+type Product = {
+  id: number; name: string; slug: string; categoryId: number; brandId: number | null;
+  description: string | null; hsnCode: string | null; gstRate: number; unit: string;
+  isHeavy: number; isActive: number; imageUrl: string | null;
+};
+type Variant = {
+  id: number; sku: string; designCode: string | null; optionLabel: string | null; price: number;
+  stock: number; moq: number; isActive: number; attributes: Record<string, string>;
+};
+type Enquiry = { reference: string; name: string; phone: string; email: string | null; subject: string; message: string; itemsJson: string; createdAt: string };
+
+function handleFailure(cause: unknown): string {
+  if (cause instanceof AccountRequestError && [401, 403].includes(cause.status)) window.location.replace('/admin');
+  return cause instanceof Error ? cause.message : 'Something went wrong.';
+}
+
+function useAdminResource<T>(path: string, revision = 0) {
+  const key = `${path}:${revision}`;
+  const [result, setResult] = useState<{ key: string; data?: T; error?: string }>();
+  useEffect(() => {
+    const abort = new AbortController();
+    accountRequest<T>(`/admin${path}`, { signal: abort.signal })
+      .then(data => { if (!abort.signal.aborted) setResult({ key, data }); })
+      .catch(cause => { if (!abort.signal.aborted) setResult({ key, error: handleFailure(cause) }); });
+    return () => abort.abort();
+  }, [key, path]);
+  return result?.key === key ? result : {};
+}
+
+async function write(path: string, method: string, body?: unknown) {
+  return accountRequest(`/admin${path}`, {
+    method, body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+function ResourceState({ error }: { error?: string }) {
+  return <p className={error ? 'text-sm text-red-700' : 'text-sm text-slate-600'} role={error ? 'alert' : 'status'}>{error ?? 'Loading…'}</p>;
+}
+
+function Pager({ page, limit, total, change }: { page: number; limit: number; total: number; change: (page: number) => void }) {
+  if (total <= limit) return null;
+  return (
+    <div className="flex flex-wrap items-center gap-3 text-sm">
+      <button className={outline} disabled={page === 1} onClick={() => change(page - 1)}>Previous</button>
+      <span>Page {page} of {Math.ceil(total / limit)}</span>
+      <button className={outline} disabled={page * limit >= total} onClick={() => change(page + 1)}>Next</button>
+    </div>
+  );
+}
+
+function Field({ label, children }: { label: string; children: ReactNode }) {
+  return <label className="block text-sm font-medium">{label}{children}</label>;
+}
+
+function Editor({ children, label, save, resetOnSuccess = false }: {
+  children: ReactNode; label: string; save: (fields: FormData) => Promise<void>; resetOnSuccess?: boolean;
+}) {
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<{ error?: string; saved?: boolean }>({});
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setBusy(true);
+    setMessage({});
+    try {
+      const form = event.currentTarget;
+      await save(new FormData(form));
+      if (resetOnSuccess) form.reset();
+      setMessage({ saved: true });
+    } catch (cause) {
+      setMessage({ error: handleFailure(cause) });
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <form className="space-y-3" onSubmit={submit}>
+      <fieldset disabled={busy} className="space-y-3">{children}</fieldset>
+      <div className="flex flex-wrap items-center gap-3">
+        <button className={button} disabled={busy}>{busy ? 'Saving…' : label}</button>
+        {message.error && <p role="alert" className="text-sm text-red-700">{message.error}</p>}
+        {message.saved && <p role="status" className="text-sm text-green-800">Saved.</p>}
+      </div>
+    </form>
+  );
+}
+
+const value = (fields: FormData, key: string) => String(fields.get(key) ?? '').trim();
+
+function Overview() {
+  const { data, error } = useAdminResource<{ activeProducts: number; categories: number; enquiries: number; activeUsers: number }>('/dashboard');
+  if (!data) return <ResourceState error={error} />;
+  const metrics = [
+    ['Active products', data.activeProducts], ['Categories', data.categories],
+    ['Enquiries', data.enquiries], ['Active accounts', data.activeUsers],
+  ] as const;
+  return <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">{metrics.map(([label, count]) => (
+    <div key={label} className={panel}><p className="text-sm text-slate-600">{label}</p><p className="mt-2 text-3xl font-bold">{count}</p></div>
+  ))}</div>;
+}
+
+function ProductEditor({ product, categories, brands, save }: {
+  product?: Product; categories: Taxonomy[]; brands: Taxonomy[];
+  save: (data: Record<string, unknown>) => Promise<void>;
+}) {
+  const selectableCategories = categories.filter(category => category.isActive === 1 || category.id === product?.categoryId);
+  return (
+    <Editor label={product ? 'Save product' : 'Create product'} save={async data => {
+      const imageUrl = value(data, 'imageUrl');
+      const payload = {
+        name: value(data, 'name'), ...(value(data, 'slug') && { slug: value(data, 'slug') }),
+        categoryId: Number(value(data, 'categoryId')), brandId: Number(value(data, 'brandId')) || null,
+        description: value(data, 'description'), hsnCode: value(data, 'hsnCode'),
+        gstRate: Number(value(data, 'gstRate')), unit: value(data, 'unit'),
+        isHeavy: data.has('isHeavy'), isActive: data.has('isActive'),
+        ...(imageUrl !== (product?.imageUrl ?? '') && { imageUrl: imageUrl || null }),
+      };
+      await save(payload);
+    }}>
+      <div className={grid}>
+        <Field label="Product name"><input name="name" className={control} required maxLength={300} defaultValue={product?.name} /></Field>
+        <Field label="URL slug"><input name="slug" className={control} placeholder="Generated from the name" maxLength={150} defaultValue={product?.slug} /></Field>
+        <Field label="Category"><select name="categoryId" className={control} required defaultValue={product?.categoryId ?? ''}>
+          <option value="" disabled>Select a category</option>{selectableCategories.map(row => <option key={row.id} value={row.id}>{row.name}</option>)}
+        </select></Field>
+        <Field label="Brand"><select name="brandId" className={control} defaultValue={product?.brandId ?? ''}>
+          <option value="">No brand</option>{brands.map(row => <option key={row.id} value={row.id}>{row.name}</option>)}
+        </select></Field>
+        <Field label="Unit"><select name="unit" className={control} defaultValue={product?.unit ?? 'sheet'}>
+          {['sheet', 'sqft', 'piece', 'set'].map(unit => <option key={unit}>{unit}</option>)}
+        </select></Field>
+        <Field label="GST rate (%)"><input name="gstRate" type="number" min={0} max={100} step="0.01" className={control} required defaultValue={product?.gstRate ?? 18} /></Field>
+        <Field label="HSN code"><input name="hsnCode" className={control} maxLength={32} defaultValue={product?.hsnCode ?? ''} /></Field>
+        <Field label="Cover image URL or path"><input name="imageUrl" className={control} maxLength={1000} defaultValue={product?.imageUrl ?? ''} /></Field>
+      </div>
+      <Field label="Description"><textarea name="description" className={control} rows={3} maxLength={4000} defaultValue={product?.description ?? ''} /></Field>
+      <div className="flex flex-wrap gap-4 text-sm">
+        <label><input type="checkbox" name="isActive" defaultChecked={Boolean(product?.isActive ?? true)} /> Listed in storefront</label>
+        <label><input type="checkbox" name="isHeavy" defaultChecked={Boolean(product?.isHeavy)} /> Heavy item</label>
+      </div>
+    </Editor>
+  );
+}
+
+function VariantEditor({ variant, save }: { variant?: Variant; save: (data: Record<string, unknown>) => Promise<void> }) {
+  return <Editor label={variant ? 'Save variant' : 'Add variant'} save={async fields => {
+    const attributes = { ...variant?.attributes };
+    for (const key of ['thickness', 'finish']) {
+      const entry = value(fields, key);
+      if (entry) attributes[key] = entry;
+      else delete attributes[key];
+    }
+    await save({
+      sku: value(fields, 'sku'), designCode: value(fields, 'designCode') || null, optionLabel: value(fields, 'optionLabel') || null,
+      price: Math.round(Number(value(fields, 'price')) * 100), stock: Number(value(fields, 'stock')),
+      moq: Number(value(fields, 'moq')), isActive: fields.has('isActive'), attributes,
+    });
+  }}>
+    <div className={grid}>
+      <Field label="SKU"><input name="sku" className={control} required maxLength={50} defaultValue={variant?.sku} /></Field>
+      <Field label="Design code"><input name="designCode" className={control} maxLength={80} defaultValue={variant?.designCode ?? ''} /></Field>
+      <Field label="Option label"><input name="optionLabel" className={control} maxLength={150} defaultValue={variant?.optionLabel ?? ''} /></Field>
+      <Field label="Price (₹, including GST)"><input name="price" type="number" min="0.01" step="0.01" className={control} required defaultValue={variant ? variant.price / 100 : undefined} /></Field>
+      <Field label="Stock"><input name="stock" type="number" min={0} step={1} className={control} required defaultValue={variant?.stock ?? 0} /></Field>
+      <Field label="Minimum order quantity"><input name="moq" type="number" min={1} step={1} className={control} required defaultValue={variant?.moq ?? 1} /></Field>
+      <Field label="Thickness"><input name="thickness" className={control} maxLength={100} defaultValue={variant?.attributes.thickness} /></Field>
+      <Field label="Finish"><input name="finish" className={control} maxLength={100} defaultValue={variant?.attributes.finish} /></Field>
+    </div>
+    <label className="block text-sm"><input type="checkbox" name="isActive" defaultChecked={Boolean(variant?.isActive ?? true)} /> Active variant</label>
+  </Editor>;
+}
+
+function ProductDetail({ id, categories, brands, refreshCatalog }: {
+  id: number; categories: Taxonomy[]; brands: Taxonomy[]; refreshCatalog: () => void;
+}) {
+  const [revision, setRevision] = useState(0);
+  const { data, error } = useAdminResource<Product & { variants: Variant[] }>(`/products/${id}`, revision);
+  if (!data) return <ResourceState error={error} />;
+  return (
+    <section className={panel}>
+      <h2 className="mb-4 text-lg font-bold">Edit {data.name}</h2>
+      <ProductEditor product={data} categories={categories} brands={brands} save={async payload => {
+        await write(`/products/${id}`, 'PUT', payload);
+        refreshCatalog();
+      }} />
+      <div className="mt-6 space-y-3 border-t border-[#E7E2D9] pt-5">
+        <h3 className="font-bold">Variants</h3>
+        {data.variants.length === 0 && <p className="text-sm text-slate-600">Add a variant with a price, stock, and attributes to let shoppers find it and add it to a quote.</p>}
+        {data.variants.map(variant => (
+          <details className={panel} key={variant.id}>
+            <summary className="cursor-pointer font-semibold">{variant.sku} · {variant.stock} in stock{variant.isActive ? '' : ' · Inactive'}</summary>
+            <div className="mt-4"><VariantEditor variant={variant} save={async payload => {
+              await write(`/variants/${variant.id}`, 'PATCH', payload);
+              setRevision(previous => previous + 1);
+            }} /></div>
+          </details>
+        ))}
+        <details className={panel}>
+          <summary className="cursor-pointer font-semibold">Add a variant</summary>
+          <div className="mt-4"><VariantEditor save={async payload => {
+            await write(`/products/${id}/variants`, 'POST', payload);
+            setRevision(previous => previous + 1);
+          }} /></div>
+        </details>
+      </div>
+    </section>
+  );
+}
+
+function Catalog() {
+  const [page, setPage] = useState(1);
+  const [revision, setRevision] = useState(0);
+  const [taxonomyRevision, setTaxonomyRevision] = useState(0);
+  const [selected, setSelected] = useState<number | null>(null);
+  const refresh = () => setRevision(previous => previous + 1);
+  const categories = useAdminResource<Taxonomy[]>('/categories', taxonomyRevision);
+  const brands = useAdminResource<Taxonomy[]>('/brands', taxonomyRevision);
+  const products = useAdminResource<ListPage<Product>>(`/products?page=${page}`, revision);
+  const taxonomyError = categories.error ?? brands.error;
+  return <div className="space-y-5">
+    <div className={grid}>
+      <section className={panel}>
+        <h2 className="mb-3 font-bold">Categories</h2>
+        {categories.data ? <Editor label="Add category" save={async data => {
+          await write('/categories', 'POST', { name: value(data, 'name'), parentId: Number(value(data, 'parentId')) || null });
+          setTaxonomyRevision(previous => previous + 1);
+        }}>
+          <Field label="Category name"><input name="name" className={control} required maxLength={150} /></Field>
+          <Field label="Parent category"><select name="parentId" className={control}>
+            <option value="">None</option>{categories.data.filter(row => row.isActive).map(row => <option key={row.id} value={row.id}>{row.name}</option>)}
+          </select></Field>
+        </Editor> : <ResourceState error={taxonomyError} />}
+        {!!categories.data?.length && <p className="mt-3 text-sm text-slate-600">{categories.data.map(row => row.name).join(', ')}</p>}
+      </section>
+      <section className={panel}>
+        <h2 className="mb-3 font-bold">Brands</h2>
+        <Editor label="Add brand" resetOnSuccess save={async data => {
+          await write('/brands', 'POST', { name: value(data, 'name') });
+          setTaxonomyRevision(previous => previous + 1);
+        }}>
+          <Field label="Brand name"><input name="name" className={control} required maxLength={100} /></Field>
+        </Editor>
