+      let items: { sku: string; quantity: number }[] = [];
+      try { items = JSON.parse(entry.itemsJson); } catch { /* Older records may lack items. */ }
+      return <details className={panel} key={entry.reference}>
+        <summary className="cursor-pointer font-semibold">{entry.subject} · {entry.name}</summary>
+        <div className="mt-3 space-y-2 text-sm">
+          <p className="break-all text-slate-600">{entry.createdAt} UTC · {entry.reference}</p>
+          <p>{entry.phone}{entry.email && ` · ${entry.email}`}</p>
+          <p className="whitespace-pre-wrap break-words">{entry.message}</p>
+          {!!items?.length && <ul className="list-inside list-disc">{items.map((item, index) => <li key={index}>{item.sku}: {item.quantity}</li>)}</ul>}
+        </div>
+      </details>;
+    })}
+    <Pager {...data} change={setPage} />
+  </div>;
+}
+
+function Users({ currentId }: { currentId: number }) {
+  const [page, setPage] = useState(1);
+  const { data, error } = useAdminResource<ListPage<Account>>(`/users?page=${page}`);
+  if (!data) return <ResourceState error={error} />;
+  return <div className="space-y-3">
+    {data.data.map(user => <section key={user.id} className={panel}>
+      <h2 className="font-bold">{user.name}{user.id === currentId ? ' (you)' : ''}</h2>
+      <p className="mb-3 break-all text-sm text-slate-600">{user.email ?? user.phone}</p>
+      {user.id === currentId ? <p className="text-sm text-slate-600">Administrator</p> :
+        <Editor label="Save access" save={async fields => {
+          await write(`/users/${user.id}`, 'PATCH', { role: value(fields, 'role'), isActive: fields.has('isActive') });
+        }}>
+          <div className="flex flex-wrap items-end gap-4">
+            <Field label="Role"><select className={control} name="role" defaultValue={user.role}>{roles.map(role => <option key={role}>{role}</option>)}</select></Field>
+            <label className="pb-2 text-sm"><input name="isActive" type="checkbox" defaultChecked={user.isActive} /> Active account</label>
+          </div>
+        </Editor>}
+    </section>)}
+    <Pager {...data} change={setPage} />
+  </div>;
+}
+
+export function AdminPanel({ account }: { account: Account }) {
+  const [tab, setTab] = useState<(typeof tabs)[number]>('Overview');
+  return (
+    <div className="mx-auto max-w-6xl px-4 py-8 sm:px-8">
+      <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
+        <div><h1 className="text-2xl font-bold">Admin panel</h1><p className="text-sm text-slate-600">Signed in as {account.name}</p></div>
+        <SignOutButton />
+      </div>
+      <nav aria-label="Admin sections" className="mb-5 flex flex-wrap gap-2">
+        {tabs.map(section => <button key={section} type="button" aria-pressed={tab === section} className={tab === section ? button : outline} onClick={() => setTab(section)}>{section}</button>)}
+      </nav>
+      {tab === 'Overview' && <Overview />}
+      {tab === 'Catalog' && <Catalog />}
+      {tab === 'Enquiries' && <Enquiries />}
+      {tab === 'Users' && <Users currentId={account.id} />}
+    </div>
+  );
+}
