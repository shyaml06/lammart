--- /dev/null
+++ b/apps/api/src/modules/auth/passwords.ts
@@ -0,0 +1,26 @@
+import { randomBytes, scrypt, timingSafeEqual } from 'node:crypto';
+import bcrypt from 'bcrypt';
+
+const parameters = { N: 32_768, r: 8, p: 1, maxmem: 64 * 1024 * 1024 };
+
+function derive(password: string, salt: Buffer): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    scrypt(password, salt, 64, parameters, (error, hash) => error ? reject(error) : resolve(hash));
+  });
+}
+
+export async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(16);
+  return `scrypt$${salt.toString('hex')}$${(await derive(password, salt)).toString('hex')}`;
+}
+
+export async function verifyPassword(password: string, encoded?: string): Promise<boolean> {
+  // Existing databases may contain bcrypt hashes. Rehash them on successful sign-in.
+  if (encoded?.startsWith('$2') && Buffer.byteLength(password) <= 72) {
+    return bcrypt.compare(password, encoded);
+  }
+
+  const match = /^scrypt\$([a-f0-9]{32})\$([a-f0-9]{128})$/.exec(encoded ?? '');
+  const actual = await derive(password, match ? Buffer.from(match[1], 'hex') : Buffer.alloc(16));
+  return !!match && timingSafeEqual(actual, Buffer.from(match[2], 'hex'));
+}
diff --git a/apps/api/src/modules/auth/session.ts b/apps/api/src/modules/auth/session.ts
new file mode 100644
index 0000000..fabe413
--- /dev/null
+++ b/apps/api/src/modules/auth/session.ts
@@ -0,0 +1,85 @@
+import { createHash, randomBytes } from 'node:crypto';
+import type { CookieOptions, Request, RequestHandler, Response } from 'express';
+import type { User } from '@lammart/shared';
+import { config } from '../../config';
+import { getDb, inTransaction } from '../../db/client';
+
+const sessionLifetime = 8 * 60 * 60 * 1000;
+const cookieName = 'auth_token';
+const cookieOptions: CookieOptions = {
+  httpOnly: true,
+  secure: config.isProduction,
+  sameSite: 'strict',
+  path: '/',
+};
+
+export type Account = Pick<User, 'id' | 'name' | 'email' | 'phone' | 'role' | 'isActive'>;
+
+export const accountFields = 'id, name, email, phone, role, is_active AS isActive';
+
+function digest(token: string): string {
+  return createHash('sha256').update(token).digest('hex');
+}
+
+function cookieToken(req: Request): string | undefined {
+  const match = /(?:^|;\s*)auth_token=([A-Za-z0-9_-]{43})(?=;|$)/.exec(req.get('Cookie') ?? '');
+  return match?.[1];
+}
+
+export function startSession(req: Request, res: Response, userId: number): void {
+  const token = randomBytes(32).toString('base64url');
+  const now = Date.now();
+  const old = cookieToken(req);
+  const db = getDb();
+  inTransaction(db, () => {
+    db.prepare('DELETE FROM auth_sessions WHERE expires_at <= ?').run(now);
+    if (old) db.prepare('DELETE FROM auth_sessions WHERE token_hash = ?').run(digest(old));
+    db.prepare('INSERT INTO auth_sessions (token_hash, user_id, expires_at) VALUES (?, ?, ?)')
+      .run(digest(token), userId, now + sessionLifetime);
+  });
+  res.cookie(cookieName, token, { ...cookieOptions, maxAge: sessionLifetime });
+}
+
+export function endSession(req: Request, res: Response): void {
+  const token = cookieToken(req);
+  if (token) getDb().prepare('DELETE FROM auth_sessions WHERE token_hash = ?').run(digest(token));
+  res.clearCookie(cookieName, cookieOptions);
+}
+
+export const requireSession: RequestHandler = (req, res, next) => {
+  const token = cookieToken(req);
+  const row = token && getDb().prepare(`
+    SELECT u.id, u.name, u.email, u.phone, u.role, u.is_active AS isActive
+    FROM auth_sessions s JOIN users u ON u.id = s.user_id
+    WHERE s.token_hash = ? AND s.expires_at > ? AND u.is_active = 1
+  `).get(digest(token), Date.now());
+  if (!row) {
+    res.status(401).json({ error: 'Sign in to continue.' });
+    return;
+  }
+  res.locals.user = { ...row, isActive: true } as Account;
+  next();
+};
+
+export function requireRole(...roles: Account['role'][]): RequestHandler {
+  return (_req, res, next) => {
+    const user = res.locals.user as Account | undefined;
+    if (!user) res.status(401).json({ error: 'Sign in to continue.' });
+    else if (!roles.includes(user.role)) res.status(403).json({ error: 'You do not have access to this area.' });
+    else next();
+  };
+}
+
+// Browser writes must come from the storefront. CLI requests without Origin remain supported.
+export const sameOriginWrite: RequestHandler = (req, res, next) => {
+  if (['GET', 'HEAD', 'OPTIONS'].includes(req.method)) return next();
+  const origin = req.get('Origin');
+  const fetchSite = req.get('Sec-Fetch-Site');
+  const allowedOrigin = (process.env.SITE_URL || process.env.CORS_ORIGIN)?.replace(/\/+$/, '');
+  if ((fetchSite && !['same-origin', 'none'].includes(fetchSite)) ||
+      (origin && fetchSite !== 'same-origin' && origin !== allowedOrigin)) {
+    res.status(403).json({ error: 'Cross-site requests are not allowed.' });
+    return;
+  }
+  next();
+};
