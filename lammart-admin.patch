@@ -0,0 +1,70 @@
+'use client';
+
+import { useState, type FormEvent } from 'react';
+import { accountRequest, type Account } from '@/lib/account-api';
+
+const inputClass = 'w-full rounded-lg border border-[#D9D3C7] px-3 py-2.5 text-slate-900';
+
+export function AccountForm({ adminOnly = false }: { adminOnly?: boolean }) {
+  const [register, setRegister] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const fields = Object.fromEntries(new FormData(event.currentTarget));
+    if (fields.email === '') delete fields.email;
+    setBusy(true);
+    setError('');
+    try {
+      const { user } = await accountRequest<{ user: Account }>(register ? '/auth/register' : '/auth/login', {
+        method: 'POST', body: JSON.stringify(fields),
+      });
+      window.location.replace(user.role === 'admin' && adminOnly ? '/admin' : '/account');
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : 'Could not sign in. Try again.');
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div>
+      <form className="space-y-4" onSubmit={submit}>
+        {register ? <>
+          <label className="block text-sm font-medium">Name<input autoComplete="name" name="name" className={inputClass} required minLength={2} maxLength={100} /></label>
+          <label className="block text-sm font-medium">Email (optional)<input autoComplete="email" name="email" type="email" className={inputClass} maxLength={254} /></label>
+          <label className="block text-sm font-medium">Indian mobile number<input autoComplete="tel-national" name="phone" type="tel" pattern="[6-9][0-9]{9}" className={inputClass} required /></label>
+        </> : <label className="block text-sm font-medium">Email or phone<input autoComplete="username" name="emailOrPhone" className={inputClass} required maxLength={254} /></label>}
+        <label className="block text-sm font-medium">Password<input autoComplete={register ? 'new-password' : 'current-password'} name="password" type="password" minLength={register ? 8 : undefined} maxLength={128} className={inputClass} required /></label>
+        {error && <p className="text-sm text-red-700" role="alert">{error}</p>}
+        <button disabled={busy} className="w-full rounded-lg bg-[#0B7A55] px-4 py-2.5 font-semibold text-white disabled:opacity-60">
+          {busy ? 'Please wait…' : register ? 'Create account' : 'Sign in'}
+        </button>
+      </form>
+      {!adminOnly && <button type="button" disabled={busy} className="mt-4 text-sm font-semibold text-[#0B7A55] underline" onClick={() => { setRegister(!register); setError(''); }}>
+        {register ? 'Already have an account? Sign in' : 'Create a customer account'}
+      </button>}
+    </div>
+  );
+}
+
+export function SignOutButton() {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  return (
+    <div>
+      <button type="button" disabled={busy} className="rounded-lg border border-[#D9D3C7] px-3 py-2 text-sm font-semibold disabled:opacity-60" onClick={async () => {
+        setBusy(true);
+        setError('');
+        try {
+          await accountRequest('/auth/logout', { method: 'POST' });
+          window.location.replace('/account');
+        } catch {
+          setError('Could not sign out. Try again.');
+          setBusy(false);
+        }
+      }}>Sign out</button>
+      {error && <p className="mt-2 text-sm text-red-700" role="alert">{error}</p>}
