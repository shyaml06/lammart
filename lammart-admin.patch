diff --git a/apps/web/lib/account-api.ts b/apps/web/lib/account-api.ts
new file mode 100644
index 0000000..3253985
--- /dev/null
+++ b/apps/web/lib/account-api.ts
@@ -0,0 +1,21 @@
+import type { User } from '@lammart/shared';
+
+export type Account = Pick<User, 'id' | 'name' | 'email' | 'phone' | 'role' | 'isActive'>;
+
+export class AccountRequestError extends Error {
+  constructor(readonly status: number, message: string) { super(message); }
+}
+
+export async function accountRequest<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(`/api/v1${path}`, {
+    ...init,
+    cache: 'no-store',
+    headers: { 'Content-Type': 'application/json' },
+  });
+  if (response.status === 204) return undefined as T;
+  const payload = await response.json().catch(() => null);
+  if (!response.ok) {
+    throw new AccountRequestError(response.status, payload?.error ?? 'Unable to complete the request.');
+  }
+  return payload as T;
+}
diff --git a/apps/web/lib/server-account.ts b/apps/web/lib/server-account.ts
new file mode 100644
index 0000000..a706ca8
--- /dev/null
+++ b/apps/web/lib/server-account.ts
@@ -0,0 +1,16 @@
+import { cookies } from 'next/headers';
+import type { Account } from './account-api';
+
+export async function getAccount(): Promise<Account | null> {
+  const token = (await cookies()).get('auth_token')?.value;
+  if (!token || !/^[A-Za-z0-9_-]{43}$/.test(token)) return null;
+  const origin = (process.env.INTERNAL_API_URL || process.env.NEXT_PUBLIC_API_URL || 'http://127.0.0.1:4000')
+    .replace(/\/+$/, '').replace(/\/api\/v1$/, '');
+  const response = await fetch(`${origin}/api/v1/me`, {
+    headers: { Cookie: `auth_token=${token}` }, cache: 'no-store', signal: AbortSignal.timeout(5000),
+  });
+  if (response.status === 401) return null;
+  if (!response.ok) throw new Error('Account service unavailable.');
+  const payload = await response.json() as { user: Account };
+  return payload.user;
+}
