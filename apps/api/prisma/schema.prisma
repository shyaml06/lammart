// ======================================================
// Lammart POS — Database Schema (PostgreSQL + Prisma)
//
// Core entities:
//   ProductVariant  — laminate/hardware catalog
//   StockLedger     — per-location current stock
//   StockMovement   — immutable inventory log
//   Party           — customers, carpenters, suppliers
//   Transaction     — estimates, challans, invoices
//   CommissionEntry — carpenter/architect commissions
//   Payment         — cash, UPI, NEFT, cheque receipts
//   User            — role-based auth
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────

enum ProductCategory {
  Laminate
  Liner
  Plywood
  EdgeBand
  Adhesive
  Hardware
}

enum ProductUnit {
  Sheet
  Box
  Roll
  Kg
  Piece
}

enum StockLocation {
  Showroom
  Godown
}

enum MovementType {
  Purchase_Inward
  Sale_Outward
  Challan_Dispatch
  Challan_Return
  Transfer_In
  Transfer_Out
  Adjustment
}

enum PartyType {
  Retail_Customer
  Carpenter
  Architect_Designer
  Contractor
  Supplier
}

enum TransactionType {
  Estimate
  Delivery_Challan
  Tax_Invoice
  Credit_Note_Return
}

enum TransactionStatus {
  Draft
  Unbilled_Challan
  Partially_Billed
  Billed
  Cancelled
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
}

enum CommissionStatus {
  Pending
  Paid
}

enum PaymentMode {
  Cash
  UPI
  NEFT
  Cheque
  Card
}

enum UserRole {
  Admin_Owner
  Billing_Counter
  Godown_Manager
}

// ── Product Catalog ─────────────────────────────

/// A specific product variant — searchable by brand + design code + finish + thickness
model ProductVariant {
  id                  String          @id @default(uuid())
  brand               String                                     // Merino, Greenlam, Century …
  category            ProductCategory
  designCode          String          @map("design_code")        // "21094", "101" — indexed for fast search
  designName          String          @map("design_name")        // "Frosty White", "Natural Walnut"
  finish              String          @default("")               // Matte, Suede, High Gloss, Fluted …
  thicknessMm         Decimal         @db.Decimal(5, 2) @map("thickness_mm")
  size                String          @default("8x4 ft")
  hsnCode             String          @default("4823") @map("hsn_code")
  gstRate             Decimal         @default(18.0) @db.Decimal(5, 2) @map("gst_rate")
  basePurchasePrice   Decimal         @db.Decimal(12, 2) @map("base_purchase_price")
  defaultSellingPrice Decimal         @db.Decimal(12, 2) @map("default_selling_price")
  unit                ProductUnit     @default(Sheet)
  sheetsPerBox        Int?            @map("sheets_per_box")
  reorderLevel        Int             @default(5) @map("reorder_level")
  imageUrl            String?         @map("image_url")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  stockLedgers   StockLedger[]
  stockMovements StockMovement[]
  lineItems      TransactionLineItem[]

  @@unique([brand, designCode, finish, thicknessMm, size])
  @@index([designCode])
  @@index([brand, designCode])
  @@index([category])
  @@map("product_variants")
}

// ── Inventory ───────────────────────────────────

/// Current stock quantity per variant per location
model StockLedger {
  id               String        @id @default(uuid())
  variantId        String        @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location         StockLocation
  quantityOnHand   Decimal       @default(0) @db.Decimal(10, 2) @map("quantity_on_hand")
  reservedQuantity Decimal       @default(0) @db.Decimal(10, 2) @map("reserved_quantity")

  @@unique([variantId, location])
  @@map("stock_ledgers")
}

/// Immutable log — every stock change creates one entry
model StockMovement {
  id            String       @id @default(uuid())
  variantId     String       @map("variant_id")
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  location      StockLocation
  movementType  MovementType @map("movement_type")
  quantity      Decimal      @db.Decimal(10, 2) // +inward / −outward
  referenceType String?      @map("reference_type") // "Transaction", "Transfer", "Purchase"
  referenceId   String?      @map("reference_id")
  notes         String?
  createdBy     String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([variantId, location])
  @@index([createdAt])
  @@map("stock_movements")
}

// ── Parties ─────────────────────────────────────

/// Customer, Carpenter, Architect, Contractor or Supplier
model Party {
  id                       String    @id @default(uuid())
  name                     String
  phone                    String    @unique
  partyType                PartyType @map("party_type")
  gstin                    String?
  billingAddress           String?   @map("billing_address")
  stateCode                String    @default("24") @map("state_code") // "24" = Gujarat
  creditLimit              Decimal   @default(0) @db.Decimal(12, 2) @map("credit_limit")
  currentBalance           Decimal   @default(0) @db.Decimal(12, 2) @map("current_balance") // +receivable / −payable
  defaultCommissionPercent Decimal   @default(0) @db.Decimal(5, 2) @map("default_commission_percent")
  createdAt                DateTime  @default(now()) @map("created_at")

  customerTransactions Transaction[]    @relation("CustomerTransactions")
  referrerTransactions Transaction[]    @relation("ReferrerTransactions")
  commissions          CommissionEntry[]
  payments             Payment[]

  @@index([phone])
  @@index([partyType])
  @@map("parties")
}

// ── Transactions (Estimates / Challans / Invoices) ──

model Transaction {
  id               String            @id @default(uuid())
  transactionType  TransactionType   @map("transaction_type")
  documentNumber   String            @unique @map("document_number")
  date             DateTime          @default(now())
  customerId       String            @map("customer_id")
  customer         Party             @relation("CustomerTransactions", fields: [customerId], references: [id])
  referrerId       String?           @map("referrer_id")
  referrer         Party?            @relation("ReferrerTransactions", fields: [referrerId], references: [id])
  status           TransactionStatus @default(Draft)
  dispatchFrom     StockLocation?    @map("dispatch_from")
  transportDetails String?           @map("transport_details")
  paymentStatus    PaymentStatus     @default(Unpaid) @map("payment_status")

  // Totals (₹)
  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2) @map("total_discount")
  totalCgst     Decimal @default(0) @db.Decimal(12, 2) @map("total_cgst")
  totalSgst     Decimal @default(0) @db.Decimal(12, 2) @map("total_sgst")
  totalIgst     Decimal @default(0) @db.Decimal(12, 2) @map("total_igst")
  grandTotal    Decimal @default(0) @db.Decimal(12, 2) @map("grand_total")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems   TransactionLineItem[]
  commissions CommissionEntry[]
  payments    Payment[]

  // Challan ↔ Invoice linking
  asChallans ChallanInvoiceLink[] @relation("ChallanSide")
  asInvoices ChallanInvoiceLink[] @relation("InvoiceSide")

  @@index([customerId])
  @@index([transactionType, status])
  @@index([documentNumber])
  @@map("transactions")
}

/// One line on an Estimate / Challan / Invoice
model TransactionLineItem {
  id              String          @id @default(uuid())
  transactionId   String          @map("transaction_id")
  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variantId       String          @map("variant_id")
  variant         ProductVariant  @relation(fields: [variantId], references: [id])
  quantity        Decimal         @db.Decimal(10, 2)
  rate            Decimal         @db.Decimal(12, 2)        // selling price per unit
  discountPercent Decimal         @default(0) @db.Decimal(5, 2) @map("discount_percent")
  taxableAmount   Decimal         @db.Decimal(12, 2) @map("taxable_amount")
  cgst            Decimal         @default(0) @db.Decimal(12, 2)
  sgst            Decimal         @default(0) @db.Decimal(12, 2)
  igst            Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)

  @@map("transaction_line_items")
}

/// Links one or more Delivery Challans to the Tax Invoice they were converted into
model ChallanInvoiceLink {
  id        String      @id @default(uuid())
  challanId String      @map("challan_id")
  challan   Transaction @relation("ChallanSide", fields: [challanId], references: [id])
  invoiceId String      @map("invoice_id")
  invoice   Transaction @relation("InvoiceSide", fields: [invoiceId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([challanId, invoiceId])
  @@map("challan_invoice_links")
}

// ── Commissions ─────────────────────────────────

model CommissionEntry {
  id                String           @id @default(uuid())
  referrerId        String           @map("referrer_id")
  referrer          Party            @relation(fields: [referrerId], references: [id])
  transactionId     String           @map("transaction_id")
  transaction       Transaction      @relation(fields: [transactionId], references: [id])
  eligibleAmount    Decimal          @db.Decimal(12, 2) @map("eligible_amount")
  commissionPercent Decimal          @db.Decimal(5, 2) @map("commission_percent")
  commissionAmount  Decimal          @db.Decimal(12, 2) @map("commission_amount")
  status            CommissionStatus @default(Pending)
  paidAt            DateTime?        @map("paid_at")
  payoutNotes       String?          @map("payout_notes")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([referrerId, status])
  @@map("commission_entries")
}

// ── Payments ────────────────────────────────────

model Payment {
  id              String       @id @default(uuid())
  partyId         String       @map("party_id")
  party           Party        @relation(fields: [partyId], references: [id])
  transactionId   String?      @map("transaction_id")
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  paymentMode     PaymentMode  @map("payment_mode")
  referenceNumber String?      @map("reference_number")
  notes           String?
  date            DateTime     @default(now())
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([partyId])
  @@map("payments")
}

// ── Users & Auth ────────────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ── Document Number Sequences ───────────────────

model Sequence {
  id            String @id            // e.g. "DC-2627", "INV-2627"
  prefix        String                // DC, INV, EST, CN
  financialYear String @map("financial_year")
  lastNumber    Int    @default(0) @map("last_number")

  @@map("sequences")
}
