+it('rolls back failed transactions and keeps committed rows', () => {
+  const db = new DatabaseSync(':memory:');
+  try {
+    db.exec('CREATE TABLE entries (id INTEGER PRIMARY KEY, value TEXT NOT NULL)');
+    inTransaction(db, () => db.prepare('INSERT INTO entries (value) VALUES (?)').run('saved'));
+    expect(() => inTransaction(db, () => {
+      db.prepare('INSERT INTO entries (value) VALUES (?)').run('discarded');
+      throw new Error('abort');
+    })).toThrow('abort');
