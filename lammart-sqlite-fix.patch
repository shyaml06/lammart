+      expect(() => inTransaction(db, () => {
+        db.prepare('INSERT INTO entries (value) VALUES (?)').run('nested discarded');
+        throw new Error('nested abort');
+      })).toThrow('nested abort');
+      db.prepare('INSERT INTO entries (value) VALUES (?)').run('nested saved');
+    });
+    expect(db.prepare('SELECT value FROM entries ORDER BY id').all().map(row => row.value)).toEqual(['saved', 'nested saved']);
+  } finally {
+    db.close();
+  }
+});
