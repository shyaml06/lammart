{
  "name": "lammart",
  "version": "1.0.0",
  "private": true,
  "description": "Laminate & Hardware Ecommerce Store",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm -w packages/shared run build && npm -w apps/api run build && npm -w apps/web run build",
    "build:shared": "npm -w packages/shared run build",
    "build:api": "npm -w apps/api run build",
    "build:web": "npm -w apps/web run build",
    "lint": "npm run lint:shared && npm run lint:api && npm run lint:web",
    "lint:shared": "npm -w packages/shared run typecheck",
    "lint:api": "npm -w apps/api run lint",
    "lint:web": "npm -w apps/web run lint",
    "test": "npm -w apps/api run test",
    "test:e2e": "tsx tests/e2e/runner.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "migrate": "npm -w apps/api run migrate",
    "start:api": "npm -w apps/api run start",
    "start:web": "npm -w apps/web run start",
    "admin:create": "npm -w apps/api run admin:create --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.39.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "ecommerce",
    "laminate",
    "hardware"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "postcss": "8.5.33"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
