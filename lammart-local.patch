diff --git a/apps/web/lib/quote-cart.ts b/apps/web/lib/quote-cart.ts
new file mode 100644
index 0000000..dad1250
--- /dev/null
+++ b/apps/web/lib/quote-cart.ts
@@ -0,0 +1,48 @@
+'use client';
+
+import { useMemo, useSyncExternalStore } from 'react';
+
+type QuoteItem = {
+  id?: number;
+  productName: string;
+  sku: string;
+  qty: number;
+  price: number;
+  unit?: string;
+  designCode?: string;
+  optionLabel?: string;
+};
+
+function subscribe(callback: () => void) {
+  window.addEventListener('storage', callback);
+  window.addEventListener('cart-updated', callback);
+  return () => {
+    window.removeEventListener('storage', callback);
+    window.removeEventListener('cart-updated', callback);
+  };
+}
+
+function getCartSnapshot() {
+  try {
+    return localStorage.getItem('lammart_cart') ?? '[]';
+  } catch {
+    return '[]';
+  }
+}
+
+export function useQuoteCart() {
+  const raw = useSyncExternalStore(subscribe, getCartSnapshot, () => null);
+  return useMemo(() => {
+    if (raw === null) return null;
+    try {
+      const items: unknown = JSON.parse(raw);
+      return Array.isArray(items) ? items.filter((item): item is QuoteItem =>
+        item && typeof item.sku === 'string' && item.sku.trim().length > 0 &&
+        typeof item.productName === 'string' && Number.isSafeInteger(item.qty) && item.qty > 0 &&
+        Number.isSafeInteger(item.price) && item.price >= 0
+      ) : [];
+    } catch {
+      return [];
+    }
+  }, [raw]);
+}
