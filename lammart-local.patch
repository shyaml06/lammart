diff --git a/apps/api/src/modules/contact/contact.router.ts b/apps/api/src/modules/contact/contact.router.ts
new file mode 100644
index 0000000..9348ce4
--- /dev/null
+++ b/apps/api/src/modules/contact/contact.router.ts
@@ -0,0 +1,42 @@
+import { randomUUID } from 'node:crypto';
+import { rateLimit } from 'express-rate-limit';
+import { Router } from 'express';
+import { z } from 'zod';
+import { getDb } from '../../db/client';
+
+const enquirySchema = z.object({
+  name: z.string().trim().min(1).max(120),
+  phone: z.string().trim().regex(/^\d{10}$/),
+  email: z.union([z.literal(''), z.string().trim().max(254).email()]).optional(),
+  subject: z.string().trim().min(1).max(100),
+  message: z.string().trim().max(4000),
+  items: z.array(z.object({
+    sku: z.string().trim().min(1).max(100),
+    quantity: z.number().int().positive().max(1_000_000),
+  })).max(100).default([]),
+}).refine(({ message, items }) => message.length > 0 || items.length > 0);
+
+export const contactRouter = Router();
+
+// The API may sit behind the storefront rewrite, so cap shared ingress generously.
+const limitEnquiries = rateLimit({ windowMs: 60_000, limit: 60, standardHeaders: 'draft-7', legacyHeaders: false, validate: { xForwardedForHeader: false } });
+
+contactRouter.post('/contact', limitEnquiries, (req, res) => {
+  const parsed = enquirySchema.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ success: false, code: 'VALIDATION_ERROR' });
+    return;
+  }
+
+  const { name, phone, email, subject, message, items } = parsed.data;
+  try {
+    const reference = randomUUID();
+    getDb().prepare(`
+      INSERT INTO contact_enquiries (reference, name, phone, email, subject, message, items_json)
+      VALUES (?, ?, ?, ?, ?, ?, ?)
+    `).run(reference, name, phone, email || null, subject, message, JSON.stringify(items));
+    res.status(201).json({ success: true, reference });
+  } catch {
+    res.status(500).json({ success: false, code: 'ENQUIRY_SAVE_FAILED' });
+  }
+});
