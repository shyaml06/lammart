@@ -0,0 +1,39 @@
+'use client';
+
+import { useQuoteCart } from '@/lib/quote-cart';
+import Link from 'next/link';
+import { ShoppingBag } from 'lucide-react';
+import { ContactForm } from './contact-form';
+
+export function CartQuoteForm() {
+  const items = useQuoteCart();
+
+  if (!items) return <p role="status" className="text-sm text-zinc-600">Loading your cart…</p>;
+
+  return (
+    <div className="space-y-6">
+      <section className="rounded-2xl border border-[#E7E2D9] bg-[#FAF8F4] p-4 sm:p-5" aria-labelledby="quote-items">
+        <div className="flex items-center justify-between gap-3">
+          <h2 id="quote-items" className="flex items-center gap-2 font-bold">
+            <ShoppingBag className="h-4 w-4 text-[#0B7A55]" aria-hidden="true" />
+            Your cart
+          </h2>
+          <Link href="/cart" className="text-sm font-semibold text-[#0B7A55] underline">Edit cart</Link>
+        </div>
+        {items.length > 0 ? (
+          <ul className="mt-3 divide-y divide-[#E7E2D9]">
+            {items.map((item, i) => (
+              <li key={`${item.sku}-${i}`} className="flex justify-between gap-3 py-2 text-sm">
+                <span>{item.productName} <span className="text-xs text-zinc-600">· {item.sku}</span></span>
+                <span className="shrink-0 font-semibold">Qty {item.qty}</span>
+              </li>
+            ))}
+          </ul>
+        ) : (
+          <p className="mt-3 text-sm text-zinc-600">Your cart is empty. You can still describe what you need below.</p>
+        )}
+      </section>
+      <ContactForm initialSubject="Cart Quote Request" items={items.map(({ sku, qty }) => ({ sku, quantity: qty }))} />
+    </div>
+  );
+}
